 "notes": {
  "files": "seg.py (mask) -> regions.py (polygons) -> volume.py (rasterize, overlay_regions.png) -> compute.py (slicer, local thickness, synthetic tests) -> run_all.py (k table) -> final.py (limb angles, region volumes) -> report.py (segments, uncertainty) -> write_json.py. ANSUR ratios: ansur.py -> ansur_ratios.json.",
  "k_definition": "k = depth along camera axis / visible width of each 1-px slice; slice area = pi/4*k*w^2 per run",
  "torso_k": "Rex zones y<290 0.90 (0.78-1.05), 290-400 0.75 (0.65-0.88), >=400 0.72 (0.65-0.85); Ollie y<270 0.90, 270-390 0.72 (0.62-0.85), >=390 0.72 (0.65-0.85); x fullness 1.07 (1.00-1.12)",
  "limb_k": "upper arm 1.0 (0.85-1.15), forearm 0.9 (0.75-1.05), Rex hand 0.6 (0.45-0.8), Ollie fist 0.75 (0.6-0.9), legs 1.0 (0.85-1.15)",
  "head_k": "Rex head+neck 1.05 (0.85-1.3), crest 0.5 (0.3-0.8); Ollie head 1.25 (1.05-1.45), neck 1.0, horns 1.0, ears 0.25",
  "tail": "Rex visible tail local thickness k 0.8 (0.6-1.0) x foreshortening 1.12 (1.0-1.25) + hidden base 0.09 (0.04-0.18) m3; Ollie tuft packing 0.15 (0.05-0.3), hidden stub 0.002 m3",
  "arms": "each arm = mean of the two visible arms (low: geometric mean; high: larger view)",
  "range": "low/high = independent log factors in quadrature incl. density; *_all_extremes = every factor at its bound",
  "density": "1030 (980-1065) kg/m3: bodybuilder tissue 1.0812 g/mL (Fry, Cisar & Housh 1987, J Appl Sport Sci Res 1(4):61-65) + ~0.045 L/kg lung+gut gas at relaxed mid-breath",
  "shared_folder": "results.json, results_method_b.json, method_b.py, mask.npy etc. in this folder belong to a separate Method B run, not this one"
 }
